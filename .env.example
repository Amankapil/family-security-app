# ==============================================================================
# FAMILY SAFETY NETWORK - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in your root and respective app directories.
# NEVER commit .env with real credentials.
# ==============================================================================

# Server & Node Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
DASHBOARD_URL=http://localhost:3000

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/family_safety

# Security & Authentication
JWT_SECRET=replace_with_a_super_secret_high_entropy_jwt_key_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_super_secret_high_entropy_refresh_key_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
PAIRING_TOKEN_TTL_MINUTES=15

# Realtime Engine (Pusher Channels - Vercel Serverless Compatible)
# Sign up free at pusher.com or use local mock
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# Next.js Public Realtime Variables
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Firebase Cloud Messaging (Admin SDK JSON as single line string or path)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Retention Policies
LOCATION_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
